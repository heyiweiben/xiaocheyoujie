---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';


const publishedSolutions = [
  {
    title: 'A10 披上玄铁，像不像魔教座驾？',
    text: '玄铁灰、朱砂红与水墨纹样组成一套重武侠整车概念。',
    image: '/images/solutions/a10-night-wuxia.webp',
    href: 'https://www.xiaohongshu.com/explore/6a61cc9d000000001b01d608?xsec_token=ABOYLyeV4fPJzAKQGI35PbmufRAt8PJIehsqHyTsGqAFg%3D&xsec_source=pc_search',
  },
  {
    title: '这么小的 A10，敢去远方吗？',
    text: '把普通小车放进远行场景，讨论一家人的行李与车顶装载边界。',
    image: '/images/solutions/a10-go-far.webp',
    href: 'https://www.xiaohongshu.com/explore/6a60ec21000000001b01ea0f?xsec_token=ABl6WwYmFMzc_-NE5hyYEhUESblHwtKcsLKLRh7fTk7iw%3D&xsec_source=pc_search',
  },
  {
    title: '车顶箱和行李篮怎么选？',
    text: '用同一台 A10 对照两种低矮车顶方案，比较比例、装载与日常气质。',
    image: '/images/solutions/a10-roof-box-vs-basket.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5e0d2200000000010300bd?xsec_token=ABfFggiHyfwydaYNwAtk-YPPfu9u92zytZIwa_0ABoYEc%3D&xsec_source=pc_search',
  },
  {
    title: '小车也能有旅行车味',
    text: '复古四灯、低重心装载与完整侧面比例，保留小车的日常感。',
    image: '/images/solutions/a10-wagon-flavour.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5c1393000000000402aeb0?xsec_token=ABt_FdqIdNljb63Zqh_1gVfYMycyWM6W7DdeYbehSuz9w%3D&xsec_source=pc_search',
  },
  {
    title: '苔原绿 A10 这样改，有点心动',
    text: '以苔原绿原色为中心，加入轻露营元素，让通勤与周末出逃兼容。',
    image: '/images/solutions/a10-light-camping.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5a362c0000000001031461?xsec_token=AB8xYY9ZYRPjyNl229fQevV6XymlCfmLZ6VDSqnOu8poA%3D&xsec_source=pc_search',
  },
  {
    title: '像不像上世纪的旅行车？',
    text: '从老旅行车的比例与生活感出发，探索 A10 的复古表达。',
    image: '/images/solutions/a10-old-century-wagon.webp',
    href: 'https://www.xiaohongshu.com/explore/6a58a4ee000000000f01de07?xsec_token=ABxEigaoYAZp6EMKH1BF_0k6g8Wcbx-RU_H7LE3HgxuCM%3D&xsec_source=pc_search',
  },
];
---

<BaseLayout alternatePath="/en/">
  <SiteHeader slot="header" />

  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="kicker">给普通小车的生活方案</span>
      <h1 id="hero-title">小车有解，<br /><em>生活有样。</em></h1>
      <p class="hero-lead">不靠堆配件，也不只做效果图。我们从真实用车问题出发，把好看、好用和能落地放在一起研究。</p>
      <a class="primary-action" href="#solutions">看看我们解决什么 <span aria-hidden="true">↘</span></a>
    </div>

    <div class="hero-art" aria-label="小车有解品牌生活主视觉">
      <img class="hero-photo" src="/brand/brand-life-hero-phone.webp?v=1" width="1024" height="1536" alt="晨光中的橙色托特包旁，手机屏幕显示纯电小车、锁车图标和电量状态，周围放着绿白织物与植物" />
      <div class="hero-mark">
        <img src="/favicon.png?v=2" width="128" height="128" alt="" />
      </div>
      <p>把每天都在开的车，变成更顺手的生活空间</p>
    </div>
  </section>

  <section class="mood-strip" aria-label="品牌价值">
    <div class="mood-track">
      <div class="mood-group">
        <span>好看一点</span><i></i><span>顺手一点</span><i></i><span>生活更有样</span><i></i><span>每一处都有理由</span><i></i>
      </div>
      <div class="mood-group" aria-hidden="true">
        <span>好看一点</span><i></i><span>顺手一点</span><i></i><span>生活更有样</span><i></i><span>每一处都有理由</span><i></i>
      </div>
    </div>
  </section>

  <section id="solutions" class="section shell path-section" aria-labelledby="paths-title">
    <div class="section-heading">
      <span class="eyebrow">已经发布的方案</span>
      <h2 id="paths-title">从真实问题出发，<br />把小车生活做成方案。</h2>
      <p>这里汇集已经在“小车有解”小红书公开发布的六套 A10 概念方案。点击卡片可查看原笔记。</p>
    </div>

    <div class="published-solutions-grid" tabindex="0" aria-label="已发布方案，可左右滑动">
      {publishedSolutions.map((solution) => (
        <a class="published-solution-card" href={solution.href} target="_blank" rel="noopener">
          <img src={solution.image} alt={solution.title} width="1086" height="1448" loading="lazy" />
          <span class="published-solution-copy">
            <small>小红书已发布 · 概念方案</small>
            <strong>{solution.title}</strong>
            <span>{solution.text}</span>
          </span>
          <span class="published-solution-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>


  <section id="stories" class="section note-section">
    <div class="shell note-grid">
      <div>
        <span class="eyebrow light">真实记录</span>
        <h2>不仅告诉你买什么，<br />也说明为什么。</h2>
      </div>
      <div class="note-copy">
        <p>实装内容公开产品型号、适用车型、关键尺寸、实际花费和使用时间；不合适、返工和被淘汰的东西也保留记录。</p>
      </div>
    </div>
  </section>

  <section id="about" class="section about-section shell">
    <div class="about-mark" aria-label="小车有解，小车生活设计">
      <span class="about-brand-word">小车有解</span>
      <span class="about-brand-tag">小车生活设计</span>
      <span class="about-brand-line">好看一点 · 顺手一点 · 生活更有样</span>
    </div>
    <div class="about-copy">
      <span class="eyebrow">关于小车有解</span>
      <h2>为普通车主整理<br />能看懂、能判断的方案。</h2>
      <p>小车有解关注小车的外观、空间、用品和日常使用。我们把设计提案、产品研究、实车测量和真实安装分开标注，让每一份内容都更容易理解和判断。</p>
      <div id="contact" class="contact-card">
        <strong>联系我们</strong>
        <p>欢迎发送选题建议、品牌合作、海外内容与车型信息。</p>
        <a href="mailto:xiaocheyoujie@proton.me">xiaocheyoujie@proton.me</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
