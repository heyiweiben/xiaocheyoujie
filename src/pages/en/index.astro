---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';


const publishedSolutions = [
  {
    title: 'A10 in “Dark Iron” Wuxia Style',
    text: 'A cinematic concept built from dark iron grey, vermilion accents and ink-inspired graphics.',
    image: '/images/solutions/a10-night-wuxia.webp',
    href: 'https://www.xiaohongshu.com/explore/6a61cc9d000000001b01d608?xsec_token=ABOYLyeV4fPJzAKQGI35PbmufRAt8PJIehsqHyTsGqAFg%3D&xsec_source=pc_search',
  },
  {
    title: 'Can Such a Small A10 Go Far?',
    text: 'A family road-trip concept exploring luggage, roof loading and the limits of a small car.',
    image: '/images/solutions/a10-go-far.webp',
    href: 'https://www.xiaohongshu.com/explore/6a60ec21000000001b01ea0f?xsec_token=ABl6WwYmFMzc_-NE5hyYEhUESblHwtKcsLKLRh7fTk7iw%3D&xsec_source=pc_search',
  },
  {
    title: 'Roof Box or Luggage Basket?',
    text: 'Two low-profile roof systems compared on the same A10 for proportion, loading and daily character.',
    image: '/images/solutions/a10-roof-box-vs-basket.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5e0d2200000000010300bd?xsec_token=ABfFggiHyfwydaYNwAtk-YPPfu9u92zytZIwa_0ABoYEc%3D&xsec_source=pc_search',
  },
  {
    title: 'A Small Car with Estate-Car Character',
    text: 'Retro auxiliary lamps, low-slung luggage and a complete side profile without losing everyday usability.',
    image: '/images/solutions/a10-wagon-flavour.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5c1393000000000402aeb0?xsec_token=ABt_FdqIdNljb63Zqh_1gVfYMycyWM6W7DdeYbehSuz9w%3D&xsec_source=pc_search',
  },
  {
    title: 'Tundra Green Light-Camping A10',
    text: 'A restrained light-camping direction that keeps the original green and works for commuting and weekends.',
    image: '/images/solutions/a10-light-camping.webp',
    href: 'https://www.xiaohongshu.com/explore/6a5a362c0000000001031461?xsec_token=AB8xYY9ZYRPjyNl229fQevV6XymlCfmLZ6VDSqnOu8poA%3D&xsec_source=pc_search',
  },
  {
    title: 'A10 as a Last-Century Estate Car',
    text: 'A retro concept informed by classic estate-car proportions and small-car living.',
    image: '/images/solutions/a10-old-century-wagon.webp',
    href: 'https://www.xiaohongshu.com/explore/6a58a4ee000000000f01de07?xsec_token=ABxEigaoYAZp6EMKH1BF_0k6g8Wcbx-RU_H7LE3HgxuCM%3D&xsec_source=pc_search',
  },
];
---

<BaseLayout
  lang="en"
  title="Small Car, Solved | Better Life, Designed"
  description="Practical design ideas for making small cars better-looking, easier to use and better suited to real life."
  alternatePath="/"
>
  <SiteHeader slot="header" lang="en" />

  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="kicker">Practical ideas for small-car living</span>
      <h1 id="hero-title">Small Car, Solved.<br /><em>Better Life, Designed.</em></h1>
      <p class="hero-lead">No random accessory pile-ups and no render-only promises. We bring style, everyday usability and real-world fitment into one clear proposal.</p>
      <a class="primary-action" href="#solutions">Explore our solutions <span aria-hidden="true">↘</span></a>
    </div>

    <div class="hero-art" aria-label="Small Car, Solved lifestyle visual">
      <img class="hero-photo" src="/brand/brand-life-hero-phone.webp?v=1" width="1024" height="1536" alt="In warm morning light, a smartphone beside an orange tote shows an electric city car, a lock icon and battery status, surrounded by green-and-white textiles and plants" />
      <div class="hero-mark"><img src="/favicon.png?v=2" width="128" height="128" alt="" /></div>
      <p>Better ideas for the car you drive every day</p>
    </div>
  </section>

  <section class="mood-strip" aria-label="Brand values">
    <div class="mood-track">
      <div class="mood-group"><span>Better looking</span><i></i><span>Easier to use</span><i></i><span>Made for real life</span><i></i><span>Every detail has a reason</span><i></i></div>
      <div class="mood-group" aria-hidden="true"><span>Better looking</span><i></i><span>Easier to use</span><i></i><span>Made for real life</span><i></i><span>Every detail has a reason</span><i></i></div>
    </div>
  </section>

  <section id="solutions" class="section shell path-section" aria-labelledby="paths-title">
    <div class="section-heading">
      <span class="eyebrow">Published concepts</span>
      <h2 id="paths-title">Real questions,<br />designed into small-car ideas.</h2>
      <p>Six A10 concepts already published by Small Car, Solved on Xiaohongshu. Open a card to view the original post.</p>
    </div>

    <div class="published-solutions-grid" tabindex="0" aria-label="Published concepts; swipe horizontally">
    {publishedSolutions.map((solution) => (
      <a class="published-solution-card" href={solution.href} target="_blank" rel="noopener">
        <img src={solution.image} alt={solution.title} width="1086" height="1448" loading="lazy" />
        <span class="published-solution-copy">
          <small>Published on Xiaohongshu · Concept</small>
          <strong>{solution.title}</strong>
          <span>{solution.text}</span>
        </span>
        <span class="published-solution-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
    </div>
  </section>


  <section id="stories" class="section note-section">
    <div class="shell note-grid">
      <div><span class="eyebrow light">Real ownership notes</span><h2>Not just what to buy,<br />but why it works.</h2></div>
      <div class="note-copy">
        <p>Installation content records the product, applicable vehicle, key dimensions, actual cost and time in use—including items that did not fit, had to be reworked or were later removed.</p>
      </div>
    </div>
  </section>

  <section id="about" class="section about-section shell">
    <div class="about-mark" aria-label="Small Car, Solved — small-car life design">
      <span class="about-brand-word">小车有解</span>
      <span class="about-brand-tag">SMALL-CAR LIFE DESIGN</span>
      <span class="about-brand-line">Better looking · easier to use · made for real life</span>
    </div>
    <div class="about-copy">
      <span class="eyebrow">About us</span>
      <h2>Small-car ideas<br />you can understand and assess.</h2>
      <p>Small Car, Solved covers exterior design, interior space, everyday gear and ownership. Concepts, product research, vehicle measurements and real installations are labelled separately.</p>
      <div id="contact" class="contact-card">
        <strong>Contact</strong>
        <p>Topic suggestions, brand partnerships, overseas-market information and vehicle insights are welcome.</p>
        <a href="mailto:xiaocheyoujie@proton.me">xiaocheyoujie@proton.me</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" lang="en" />
</BaseLayout>
