---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StatusBadge from '../../components/StatusBadge.astro';

const paths = [
  {
    number: '01',
    eyebrow: 'Shape the whole idea first',
    title: 'Style & Exterior',
    text: 'Start with colour, proportion, wheels and use cases—then decide what is worth changing and what should stay.',
    href: '#a10',
    tone: 'coral',
  },
  {
    number: '02',
    eyebrow: 'Solve everyday friction',
    title: 'Space & Everyday Gear',
    text: 'Choose storage, loading and care solutions that fit the car and make daily use genuinely easier.',
    href: '#proof',
    tone: 'cream',
  },
  {
    number: '03',
    eyebrow: 'Verify in the real world',
    title: 'Installation & Ownership Notes',
    text: 'Product details, key dimensions, installation, cost and long-term use are kept separate from concept work.',
    href: '#stories',
    tone: 'teal',
  },
];
---

<BaseLayout
  lang="en"
  title="Small Car, Solved | Small-Car Life Design"
  description="Practical design ideas for making small cars better-looking, easier to use and better suited to real life."
  alternatePath="/"
>
  <SiteHeader slot="header" lang="en" />

  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="kicker">Practical ideas for small-car living</span>
      <h1 id="hero-title">Small Car, Solved.<br /><em>Life, Better Designed.</em></h1>
      <p class="hero-lead">No random accessory pile-ups and no render-only promises. We bring style, everyday usability and real-world fitment into one clear proposal.</p>
      <a class="primary-action" href="#solutions">Explore our solutions <span aria-hidden="true">↘</span></a>
    </div>

    <div class="hero-art" aria-label="Small Car, Solved lifestyle visual">
      <img class="hero-photo" src="/brand/brand-life-hero.webp" width="1024" height="1536" alt="An orange tote, car key, textiles and greenery in warm morning light" />
      <div class="hero-mark"><img src="/favicon.png?v=2" width="128" height="128" alt="" /></div>
      <p>Better ideas for the car you drive every day</p>
    </div>
  </section>

  <section class="mood-strip" aria-label="Brand values">
    <div class="mood-track">
      <div class="mood-group"><span>Better looking</span><i></i><span>Easier to use</span><i></i><span>Made for real life</span><i></i><span>Every detail has a reason</span><i></i></div>
      <div class="mood-group" aria-hidden="true"><span>Better looking</span><i></i><span>Easier to use</span><i></i><span>Made for real life</span><i></i><span>Every detail has a reason</span><i></i></div>
    </div>
  </section>

  <section id="solutions" class="section shell path-section" aria-labelledby="paths-title">
    <div class="section-heading">
      <span class="eyebrow">What we cover</span>
      <h2 id="paths-title">Define the problem.<br />Then design the solution.</h2>
      <p>Each proposal sets out its use case, practical boundaries and next action. Swipe horizontally on mobile.</p>
    </div>
    <div class="path-list">
      {paths.map((path) => (
        <a class:list={['path-card', `path-${path.tone}`]} href={path.href}>
          <span class="path-number">{path.number}</span>
          <span class="path-eyebrow">{path.eyebrow}</span>
          <h3>{path.title}</h3>
          <p>{path.text}</p>
          <span class="path-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section id="a10" class="section feature-section">
    <div class="shell feature-grid">
      <div class="feature-image-wrap">
        <img src="/images/a10/city-departure.webp" width="1200" height="1600" alt="LEAPMOTOR A10 urban-life concept" loading="lazy" />
        <div class="image-stamp">A10 Focus</div>
      </div>
      <div class="feature-copy">
        <div class="feature-meta"><StatusBadge status="concept" lang="en" /><span>International focus</span></div>
        <h2>LEAPMOTOR A10:<br />an urban everyday-life proposal.</h2>
        <p>Built around commuting, errands and short weekend trips. For international markets, product fitment, trim availability and local regulations must be checked country by country.</p>
        <ul class="feature-points">
          <li><span>01</span> Keep the compact, city-friendly character</li>
          <li><span>02</span> Make colour, accessories and use case work together</li>
          <li><span>03</span> Label concept, fitment and installation status clearly</li>
        </ul>
        <a class="text-link" href="/en/solutions/a10-city-departure/">View the A10 proposal <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="proof" class="section proof-section shell" aria-labelledby="proof-title">
    <div class="section-heading compact">
      <span class="eyebrow">Clear verification labels</span>
      <h2 id="proof-title">Know whether it is<br />an idea or a proven result.</h2>
      <p>Concept visuals communicate direction. They do not imply confirmed product fitment or a completed installation.</p>
    </div>
    <ol class="proof-flow" tabindex="0" aria-label="Verification stages; swipe horizontally on mobile">
      <li class="is-current" aria-current="step"><span>01</span><strong>Concept</strong><small>Direction shown; installation not yet proven</small></li>
      <li><span>02</span><strong>Research</strong><small>Product data, vehicle information and local rules checked</small></li>
      <li><span>03</span><strong>Vehicle measurement</strong><small>Key dimensions and mounting points confirmed</small></li>
      <li><span>04</span><strong>Installed</strong><small>Products, cost and real installation documented</small></li>
      <li><span>05</span><strong>Long-term verified</strong><small>Kept, changed or removed after continued use</small></li>
    </ol>
  </section>

  <section id="stories" class="section note-section">
    <div class="shell note-grid">
      <div><span class="eyebrow light">Real ownership notes</span><h2>Not just what to buy,<br />but why it works.</h2></div>
      <div class="note-copy">
        <p>Installation content records the product, applicable vehicle, key dimensions, actual cost and time in use—including items that did not fit, had to be reworked or were later removed.</p>
        <a class="coming-label" href="#a10">Explore the A10 focus <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="about" class="section about-section shell">
    <div class="about-mark" aria-label="Small Car, Solved — small-car life design">
      <span class="about-brand-word">小车有解</span>
      <span class="about-brand-tag">SMALL-CAR LIFE DESIGN</span>
      <span class="about-brand-line">Better looking · easier to use · made for real life</span>
    </div>
    <div class="about-copy">
      <span class="eyebrow">About us</span>
      <h2>Small-car ideas<br />you can understand and assess.</h2>
      <p>Small Car, Solved covers exterior design, interior space, everyday gear and ownership. Concepts, product research, vehicle measurements and real installations are labelled separately.</p>
      <div id="contact" class="contact-card">
        <strong>Contact</strong>
        <p>Topic suggestions, brand partnerships, overseas-market information and vehicle insights are welcome.</p>
        <a href="mailto:xiaocheyoujie@proton.me">xiaocheyoujie@proton.me</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" lang="en" />
</BaseLayout>
