---
interface Props { lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="footer-brand" href={isEnglish ? '/en/' : '/'} aria-label={isEnglish ? 'Small Car, Solved home' : '小车有解首页'}>
        <img class="footer-lockup" src="/brand/xiaocheyoujie-horizontal-white-2048.png" width="2048" height="998" alt={isEnglish ? 'Small Car, Solved' : '小车有解｜认真研究小车，用心设计生活'} loading="lazy" />
      </a>
      <p>{isEnglish ? 'Better ideas for small-car living.' : '小车有解，生活有样。'}</p>
    </div>
    <div class="footer-note">
      <a class="footer-action" href={isEnglish ? '/en/#contact' : '/#contact'}>{isEnglish ? 'Contact us' : '联系我们'} <span aria-hidden="true">↗</span></a>
      <a href="mailto:xiaocheyoujie@proton.me">xiaocheyoujie@proton.me</a>
      <p>{isEnglish ? 'Concepts, research, measurements and real-world installations are clearly labelled.' : '概念方案、资料研究、实车测量与真实安装均明确标注。'}</p>
      <p>© 2026 小车有解</p>
    </div>
  </div>
</footer>
