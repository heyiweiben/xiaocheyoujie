---
interface Props {
  status: 'concept' | 'researched' | 'measured' | 'installed' | 'verified';
  lang?: 'zh' | 'en';
}

const zhLabels = {
  concept: '概念方案',
  researched: '资料研究',
  measured: '实车测量',
  installed: '已安装',
  verified: '长期验证',
};

const enLabels = {
  concept: 'Concept',
  researched: 'Researched',
  measured: 'Vehicle measured',
  installed: 'Installed',
  verified: 'Long-term verified',
};

const { status, lang = 'zh' } = Astro.props;
const labels = lang === 'en' ? enLabels : zhLabels;
---

<span class:list={['status-badge', `status-${status}`]}>{labels[status]}</span>
