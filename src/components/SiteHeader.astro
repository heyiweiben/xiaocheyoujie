---
interface Props { lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';
const base = isEnglish ? '/en/' : '/';
const links = isEnglish
  ? [
      { href: '/en/#solutions', label: 'Solutions' },
      { href: '/en/#contact', label: 'Contact' },
    ]
  : [
      { href: '/#solutions', label: '找方案' },
      { href: '/#contact', label: '联系我们' },
    ];
const aboutLabel = isEnglish ? 'About Us' : '关于我们';
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand-link" href={base} aria-label={isEnglish ? 'Small Car, Solved home' : '小车有解首页'}>
      <img
        class="brand-lockup"
        src="/brand/xiaocheyoujie-horizontal-white-2048.png"
        width="2048"
        height="998"
        alt={isEnglish ? 'Small Car, Solved — study small cars seriously, design life thoughtfully' : '小车有解｜认真研究小车，用心设计生活'}
      />
    </a>

    <nav class="desktop-nav" aria-label={isEnglish ? 'Main navigation' : '主导航'}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-about" href={`${base}#about`}>{aboutLabel}</a>
      <a class="language-switch" href={isEnglish ? '/' : '/en/'} lang={isEnglish ? 'zh-CN' : 'en'}>{isEnglish ? '中文' : 'EN'}</a>
    </nav>

    <details class="mobile-menu">
      <summary
        aria-label={isEnglish ? 'Open navigation' : '打开导航'}
        data-open-label={isEnglish ? 'Open navigation' : '打开导航'}
        data-close-label={isEnglish ? 'Close navigation' : '关闭导航'}
      ><span></span><span></span></summary>
      <nav aria-label={isEnglish ? 'Mobile navigation' : '手机导航'}>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href={`${base}#about`}>{aboutLabel}</a>
        <a href={isEnglish ? '/' : '/en/'} lang={isEnglish ? 'zh-CN' : 'en'}>{isEnglish ? '中文' : 'English'}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const summary = menu?.querySelector('summary');
  const syncMenuLabel = () => summary?.setAttribute('aria-label', menu?.open ? summary.dataset.closeLabel ?? '关闭导航' : summary.dataset.openLabel ?? '打开导航');

  menu?.addEventListener('toggle', syncMenuLabel);
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.removeAttribute('open'));
  });
  document.addEventListener('pointerdown', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.removeAttribute('open');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') menu?.removeAttribute('open');
  });
</script>
