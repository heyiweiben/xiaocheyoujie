---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'zh-CN' | 'en';
  alternatePath?: string;
}

const {
  title = '小车有解｜小车生活设计',
  description = '研究普通小车怎么变得更好看、更好用、更适合真实生活。',
  image = '/brand/social-card.png',
  lang = 'zh-CN',
  alternatePath,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const alternateURL = alternatePath ? new URL(alternatePath, Astro.site ?? Astro.url) : undefined;
const defaultURL = lang === 'en' && alternateURL ? alternateURL : canonicalURL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fff8ee" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternateURL && <link rel="alternate" hreflang={lang === 'en' ? 'zh-CN' : 'en'} href={alternateURL} />}
    <link rel="alternate" hreflang="x-default" href={defaultURL} />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
